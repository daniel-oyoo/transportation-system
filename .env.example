SPRING_PROFILES_ACTIVE=dev
DEV_DATABASE_URL=jdbc:h2:file:./data/easycoach-dev;DB_CLOSE_ON_EXIT=FALSE
DEV_DATABASE_USERNAME=sa
DEV_DATABASE_PASSWORD=

# Set SPRING_PROFILES_ACTIVE=prod and configure these in the deployment secret store.
DATABASE_URL=jdbc:postgresql://localhost:5432/easycoach
DATABASE_USERNAME=easycoach_app
DATABASE_PASSWORD=replace-with-a-secret
APP_CORS_ALLOWED_ORIGINS=https://your-booking-site.example